

{% code
type LoginPage struct {
	Token string
	Message string
}
%}

{% func (l LoginPage) Body(pctx *PageContext) %}
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>go-gpo</title>
	<style>
		@media (prefers-color-scheme: dark){body {color:#fff;background:#000}}
		body{margin:1em auto;max-width:80em;padding:0 .62em;font:1.2em/1.62 sans-serif;}
		fieldset{margin:auto;max-width: 10em;padding: 1em;}
	</style>
</head>
<body>
	<content>
		<form method="POST">
			<input type="hidden" name="token" value="{%s l.Token %}"></input>
			<fieldset>
				<legend>go-gpo</legend>
				{% if l.Message != "" %}<p><b>{%s l.Message %}</b></p>{% endif %}

				<label for="login">Login:</label><br/>
				<input type="text" id="login" name="login"></input><br/>

				<label for="password">Password</label><br/>
				<input type="password" id="password" name="password"></input><br/>

				<button type="submit">Login</button>
			</fieldset>
		</form>
	</content>
</body>
</html>

{% endfunc %}
